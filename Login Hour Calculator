import React, { useState, useEffect } from 'react';
import {
  Upload,
  RefreshCw,
  Clock,
  Timer,
  Plus,
  Activity,
  Maximize2,
  Zap,
  Target
} from 'lucide-react';

/**
 * FIXED: Replaced import.meta.env with a safer check for production environments.
 * In a standard Vite deployment, this will be populated. 
 * In this preview environment, we use an empty string as a fallback.
 */
const getApiKey = () => {
  try {
    // Check for Vite/Vercel environment variables safely
    if (typeof process !== 'undefined' && process.env?.VITE_GEMINI_API_KEY) {
      return process.env.VITE_GEMINI_API_KEY;
    }
    // Fallback for standard Vite import meta (wrapped in try/catch for compatibility)
    return ""; 
  } catch (e) {
    return "";
  }
};

const apiKey = getApiKey();

const App = () => {
  // --- State with LocalStorage Persistence ---
  const [loading, setLoading] = useState(false);
  const [inputs, setInputs] = useState(() => {
    try {
      const saved = localStorage.getItem('chronos_data');
      return saved ? JSON.parse(saved) : {
        target: "07:15:00",
        totalLogin: "00:00:00",
        totalPause: "00:00:00",
        concession: "00:00:00",
        lastFetched: "00:00:00"
      };
    } catch (e) {
      return {
        target: "07:15:00",
        totalLogin: "00:00:00",
        totalPause: "00:00:00",
        concession: "00:00:00",
        lastFetched: "00:00:00"
      };
    }
  });

  // Save to local storage whenever inputs change
  useEffect(() => {
    localStorage.setItem('chronos_data', JSON.stringify(inputs));
  }, [inputs]);

  // --- Time Helpers ---
  const secondsToHMS = (totalSeconds) => {
    const isNegative = totalSeconds < 0;
    const absSeconds = Math.abs(totalSeconds);
    const h = Math.floor(absSeconds / 3600);
    const m = Math.floor((absSeconds % 3600) / 60);
    const s = Math.round(absSeconds % 60);
    const pad = (n) => n.toString().padStart(2, '0');
    return `${isNegative ? '-' : ''}${pad(h)}:${pad(m)}:${pad(s)}`;
  };

  const hmsToSeconds = (hmsStr) => {
    if (!hmsStr || typeof hmsStr !== 'string') return 0;
    const trimmed = hmsStr.trim();
    const isNegative = trimmed.startsWith('-');
    const cleanStr = isNegative ? trimmed.substring(1) : trimmed;
    const parts = cleanStr.split(':').map(Number);
    let seconds = 0;
    if (parts.length === 3) seconds = (parts[0] * 3600) + (parts[1] * 60) + parts[2];
    else if (parts.length === 2) seconds = (parts[0] * 3600) + (parts[1] * 60);
    else seconds = parseFloat(hmsStr) * 3600 || 0;
    return isNegative ? -seconds : seconds;
  };

  // --- Calculation Engine ---
  const sLog = hmsToSeconds(inputs.totalLogin);
  const sPau = hmsToSeconds(inputs.totalPause);
  const sCon = hmsToSeconds(inputs.concession);
  const sTar = hmsToSeconds(inputs.target);
  const sFet = hmsToSeconds(inputs.lastFetched);

  const netLoginSeconds = sLog - sPau + sCon;
  const deficitSeconds = netLoginSeconds - sTar;
  const completedSeconds = Math.abs(sFet) + Math.abs(deficitSeconds);

  // --- OCR Logic ---
  const handleUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => analyzeImage(reader.result);
      reader.readAsDataURL(file);
    }
  };

  const analyzeImage = async (base64Data) => {
    // Note: The apiKey check is handled here for the OCR feature
    const activeKey = apiKey || ""; 
    if (!activeKey) {
      console.warn("API Key missing. Please set VITE_GEMINI_API_KEY in your environment.");
      return;
    }
    
    setLoading(true);
    const base64Content = base64Data.split(',')[1];
    const systemPrompt = `Extract exactly: Total Login, Total Pause, and Last Fetched Balance. Return JSON: {"totalLogin": "HH:MM:SS", "totalPause": "HH:MM:SS", "lastFetched": "HH:MM:SS"}`;

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${activeKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ role: "user", parts: [{ text: "OCR extract timings." }, { inlineData: { mimeType: "image/png", data: base64Content } }] }],
          systemInstruction: { parts: [{ text: systemPrompt }] },
          generationConfig: { responseMimeType: "application/json" }
        })
      });
      const result = await response.json();
      const text = result.candidates?.[0]?.content?.parts?.[0]?.text;
      if (text) {
        const data = JSON.parse(text);
        setInputs(prev => ({ ...prev, ...data }));
      }
    } catch (err) {
      console.error("OCR Fail", err);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-[#050505] text-slate-100 font-sans p-6 md:p-12 selection:bg-violet-500/30">
      <div className="max-w-6xl mx-auto">
        
        {/* Header */}
        <header className="flex flex-col md:flex-row justify-between items-center mb-16 gap-8 bg-white/[0.03] border border-white/[0.08] p-8 rounded-[2.5rem] backdrop-blur-md">
          <div className="flex items-center gap-6">
            <div className="w-16 h-16 bg-gradient-to-br from-violet-600 to-fuchsia-600 rounded-3xl flex items-center justify-center shadow-2xl shadow-violet-500/40">
              <Timer size={32} className="text-white" />
            </div>
            <div>
              <h1 className="text-3xl font-black tracking-tighter text-white uppercase">CHRONOS<span className="text-violet-500">.X</span></h1>
              <div className="flex items-center gap-2">
                <span className="w-2 h-2 bg-emerald-500 rounded-full animate-pulse" />
                <p className="text-[10px] font-bold text-slate-500 uppercase tracking-[0.3em]">Absolute Logic Processor</p>
              </div>
            </div>
          </div>

          <div className="flex items-center gap-6">
            <div className="flex flex-col items-end">
              <span className="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-1">Shift Target</span>
              <input
                className="bg-transparent font-mono text-xl font-bold text-white outline-none w-28 text-right border-b border-white/10 focus:border-violet-500 transition-all"
                value={inputs.target}
                onChange={e => setInputs({...inputs, target: e.target.value})}
              />
            </div>
            <label className="bg-violet-600 hover:bg-violet-500 text-white px-10 py-5 rounded-3xl font-black text-xs uppercase tracking-widest cursor-pointer flex items-center gap-3 transition-all active:scale-95 shadow-lg shadow-violet-600/20">
              {loading ? <RefreshCw className="animate-spin" size={20} /> : <Upload size={20} />}
              {loading ? "SCANNING..." : "SCAN REPORT"}
              <input type="file" hidden accept="image/*" onChange={handleUpload} />
            </label>
          </div>
        </header>

        {/* Dash Grid */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
          <div className="bg-white/[0.02] border border-white/[0.05] p-8 rounded-[2rem] relative group">
            <label className="text-[10px] font-black text-slate-500 uppercase block mb-4 tracking-widest">Total Login</label>
            <input 
              className="bg-transparent font-mono text-3xl font-bold text-white w-full outline-none" 
              value={inputs.totalLogin} 
              onChange={e => setInputs({...inputs, totalLogin: e.target.value})} 
            />
          </div>

          <div className="bg-white/[0.02] border border-white/[0.05] p-8 rounded-[2rem] relative text-rose-500 group">
            <label className="text-[10px] font-black text-slate-500 uppercase block mb-4 tracking-widest">Total Pause</label>
            <input 
              className="bg-transparent font-mono text-3xl font-bold text-rose-500 w-full outline-none" 
              value={inputs.totalPause} 
              onChange={e => setInputs({...inputs, totalPause: e.target.value})} 
            />
          </div>

          <div className="bg-white/[0.02] border border-white/[0.05] p-8 rounded-[2rem] relative text-emerald-500 group">
            <label className="text-[10px] font-black text-slate-500 uppercase block mb-4 tracking-widest">Concession</label>
            <input 
              className="bg-transparent font-mono text-3xl font-bold text-emerald-400 w-full outline-none" 
              value={inputs.concession} 
              onChange={e => setInputs({...inputs, concession: e.target.value})} 
            />
          </div>

          <div className="bg-violet-600/[0.05] border border-violet-500/20 p-8 rounded-[2rem] relative shadow-2xl shadow-violet-500/5 group">
            <label className="text-[10px] font-black text-violet-400 uppercase block mb-4 tracking-widest">Last Fetched</label>
            <input 
              className="bg-transparent font-mono text-3xl font-bold text-white w-full outline-none" 
              value={inputs.lastFetched} 
              onChange={e => setInputs({...inputs, lastFetched: e.target.value})} 
            />
          </div>
        </div>

        {/* Calculation Summary */}
        <div className="flex flex-col md:flex-row gap-6 mb-12">
            <div className="flex-1 bg-white/[0.01] border border-white/[0.04] p-8 rounded-[2rem] flex justify-between items-center">
                <span className="text-[11px] font-black text-slate-600 uppercase tracking-widest">Net Login (L-P+C)</span>
                <span className="font-mono text-2xl font-bold text-white">{secondsToHMS(netLoginSeconds)}</span>
            </div>
            <div className="flex-1 bg-white/[0.01] border border-white/[0.04] p-8 rounded-[2rem] flex justify-between items-center">
                <span className="text-[11px] font-black text-slate-600 uppercase tracking-widest">Calculated Deficit</span>
                <span className={`font-mono text-2xl font-bold ${deficitSeconds >= 0 ? 'text-emerald-500' : 'text-orange-500'}`}>
                    {secondsToHMS(deficitSeconds)}
                </span>
            </div>
        </div>

        {/* Final Result Card */}
        <div className="relative group">
          <div className="absolute -inset-1 bg-gradient-to-r from-violet-600 to-fuchsia-600 rounded-[3.5rem] blur opacity-20 group-hover:opacity-40 transition-opacity" />
          <div className="relative bg-[#0a0a0a] border border-white/10 rounded-[3rem] p-12 flex flex-col items-center justify-center text-center">
            <div className="bg-violet-500/10 text-violet-400 px-6 py-2 rounded-full text-[10px] font-black uppercase tracking-[0.4em] mb-8 border border-violet-500/20">
              Absolute Shift Logic
            </div>
            
            <h2 className="text-slate-500 text-sm font-bold uppercase tracking-[0.5em] mb-4">Completed Shift Time</h2>
            
            <div className="text-7xl md:text-9xl font-black text-white font-mono tracking-tighter mb-8 bg-gradient-to-b from-white to-slate-500 bg-clip-text text-transparent">
              {secondsToHMS(completedSeconds)}
            </div>

            <div className="flex items-center gap-4 text-slate-600 font-mono text-xs border-t border-white/5 pt-8 w-full justify-center">
              <span>ABS({inputs.lastFetched})</span>
              <Plus size={12} className="text-violet-500" />
              <span>ABS({secondsToHMS(deficitSeconds)})</span>
            </div>
          </div>
        </div>

        <footer className="mt-20 text-center">
            <p className="text-[10px] font-black text-slate-700 uppercase tracking-[0.5em]">Chronos Engine V4.0 // High Fidelity Tracking</p>
        </footer>

      </div>
    </div>
  );
};

export default App;
